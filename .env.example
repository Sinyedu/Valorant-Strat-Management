# MongoDB connection string (server-only; never prefix with NEXT_PUBLIC_).
# Local example: mongodb://127.0.0.1:27017/vsmp
# Atlas example: mongodb+srv://<user>:<password>@<cluster>/vsmp
MONGODB_URI=mongodb://127.0.0.1:27017/vsmp

# Secret used to sign session JWTs. Generate with: npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=replace-with-a-long-random-string

# Needed for `pnpm start` (production mode) when not deployed on a platform that
# sets this for you. Only enable behind a host/proxy you control.
AUTH_TRUST_HOST=true

# Optional: enables MongoDB integration tests (`pnpm test`). The database name
# MUST contain "test"; the tests drop it. Never point this at real data.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/vsmp_test
